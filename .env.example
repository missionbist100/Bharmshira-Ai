# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI GPT models.
OPENAI_API_KEY=""

# SEARCH_API_KEY: Optional external search provider key (Tavily/Serper/Brave). Gemini built-in search grounding is also used.
SEARCH_API_KEY=""

# Model Configuration
OPENAI_MODEL_1="gpt-4o-mini"
OPENAI_MODEL_2="gpt-4o"
GEMINI_MODEL_1="gemini-3.8-flash"
GEMINI_MODEL_2="gemini-3.1-pro-preview"

# Database Configuration (Optional external PostgreSQL URL; falls back to embedded relational SQLite)
DATABASE_URL=""

# Authentication & Security
AUTH_SECRET="bharmashira-super-secret-jwt-key-change-in-production"
ADMIN_KEY="admin-access-token-bharmashira-2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

